<!DOCTYPE html>
<html>
<head>
<title>Account Lockout Investigator</title>
<HTA:APPLICATION
    APPLICATIONNAME="Account Lockout Investigator"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    BORDER="thin"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    WINDOWSTATE="normal"
    SHOWINTASKBAR="yes"
/>
<!-- BORDER/MAXIMIZEBUTTON/window size match AccountLockoutFinder-v2.hta
     exactly (thin border, maximize disabled, resizeTo(1000,760)) -- v3 no
     longer picks its own window size. Every control in the search row has a
     fixed pixel width (see CSS), not a percentage/table hint, so this fixed
     window size can never cause a layout break. -->
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

/* ─── Single global layout contract ──────────────────────────────────────────
   Every box on this page is bounded by this one rule: html/body can never
   exceed the window, and overflow-x is clipped at the root rather than left
   to each individual box to reinvent. Child boxes (.search-card, #resultBox)
   inherit this containment automatically through normal block flow -- they
   do NOT repeat width/max-width/box-sizing themselves. If a future box
   overflows, fix it here once, not per-element.
   Control height (SamAccountName input, dropdowns, buttons) is likewise
   defined once in the shared rule below, instead of being repeated in every
   individual selector. (No CSS custom properties/calc() here on purpose --
   mshta's Trident engine doesn't support var()/calc() reliably, so "define
   once" means one grouped CSS rule, not a CSS variable.) */
html, body { width: 100%; max-width: 100%; overflow-x: hidden; }

body {
    font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;
    background: #0a1628; color: #e2e8f0;
    padding: 26px 30px 16px 30px;
}
.pg-title { font-size: 20px; font-weight: 700; color: #60a5fa; margin-bottom: 4px; letter-spacing: -0.01em; }
.pg-sub   { font-size: 11px; color: #475569; margin-bottom: 20px; }
.pg-sub span { color: #334155; margin: 0 6px; }
/* Single source of truth for the page's content width: every box that should
   line up with the search-card/resultBox's right edge (the footer status
   row, the Export/Copy button row, and the credit line) shares this ONE
   declaration instead of each guessing its own width or defaulting to 100%
   of body (which is wider than 900px and was why the buttons/tagline were
   drifting past the boxes above them). Change the width in exactly one
   place here, not in five separate rules. */
.search-card, #resultBox, .footer-row, .copy-row, .tool-credit { width: 940px; }
.search-card { background: #0d1f35; border: 1px solid #1e3a5f; border-radius: 9px; padding: 14px 18px; margin-bottom: 14px; overflow-x: auto; }
/* Every control in the row has a fixed, hardcoded pixel width (no runtime
   JS measurement, no CSS percentage/table hints), sized to fit inside
   .search-card's 740px (minus its own 36px padding = 704px available). */
.sr-row { white-space: nowrap; overflow: hidden; }
.sr-lbl { font-size: 12px; font-weight: 600; color: #94a3b8; white-space: nowrap; display: inline-block; vertical-align: middle; margin-right: 6px; }
.sr-lbl-gap { margin-left: 8px; }

/* Shared control sizing -- one rule for every input/select/button in the search row */
#samInput, .sel-input, .btn-go, .btn-clr {
    height: 34px; line-height: 32px; vertical-align: middle;
    border-radius: 5px; font-size: 12px; display: inline-block;
}
#samInput {
    width: 160px; background: #0a1628; border: 1px solid #2d4a6e;
    padding: 0 10px; color: #f1f5f9; font-size: 13px; font-family: Consolas, 'Courier New', monospace;
}
.sel-input {
    width: 50px; background: #0a1628; border: 1px solid #2d4a6e; margin-right: 8px;
    padding: 0 4px; color: #f1f5f9; font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;
}
.btn-go  { background: #2563eb; color: #fff; border: none; padding: 0 10px; font-weight: 700; cursor: pointer; white-space: nowrap; margin-right: 6px; }
.btn-go:hover  { background: #1d4ed8; }
.btn-go:active { background: #1e40af; }
.btn-clr { background: #1a2332; color: #94a3b8; border: 1px solid #2d3748; padding: 0 8px; font-weight: 600; cursor: pointer; white-space: nowrap; }
.btn-clr:hover { background: #2d3748; color: #e2e8f0; }
.res-label { font-size: 10px; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; padding-left: 2px; }
.tab-row { margin-top: 10px; }
.tab-btn { background: #0d1f35; color: #7fa8d0; border: 1px solid #1e3a5f; border-bottom: none; border-radius: 6px 6px 0 0; padding: 7px 20px; font-size: 12px; font-weight: 700; cursor: pointer; margin-right: 4px; font-family: 'Segoe UI', Tahoma, Geneva, sans-serif; }
.tab-btn:hover { color: #a8c8e8; }
.tab-active { background: #071122; color: #60a5fa; border-color: #2d4a6e; }
#resultBox {
    background: #071122; border: 1px solid #1a3050; border-radius: 8px;
    padding: 18px 22px; height: 430px; overflow-y: auto; overflow-x: auto;
    font-family: Consolas, 'Courier New', monospace; font-size: 12px; line-height: 1.75;
    color: #7fa8d0; white-space: pre;
}
.footer-row { margin-top: 8px; font-size: 12px; color: #2d5a8e; }
.footer-row table { width: 100%; border-collapse: collapse; }
.footer-row td { vertical-align: middle; }
.copy-row { display: table; text-align: right; margin-top: 6px; margin-bottom: 2px; }
.btn-copy { background: #1a2d42; color: #7fa8d0; border: 1px solid #2d4a6e; border-radius: 5px; padding: 5px 16px; font-size: 11px; font-family: 'Segoe UI', Tahoma, Geneva, sans-serif; font-weight: 600; cursor: pointer; letter-spacing: 0.04em; margin-left: 8px; }
.btn-copy:hover  { background: #1e3a5f; color: #a8c8e8; border-color: #3d6a9e; }
.btn-copy:active { background: #162840; }
.tool-credit { margin-top: 6px; padding-top: 5px; border-top: 1px solid #0e2035; font-size: 12px; color: #4a7fa8; text-align: right; letter-spacing: 0.03em; }
</style>
</head>
<body>

<div class="pg-title">&#128270; Account Lockout Investigator</div>
<div class="pg-sub">
    Searches all Domain Controllers in your AD forest, in parallel
    <span>|</span> Events 4740 / 4771 / 4776 / 4625 + AD attribute &amp; replication-metadata cross-check <span>|</span><br>
    Run as Domain Admin or Event Log Reader
</div>

<!-- Non-table row on purpose: an auto-layout <table> sizes its columns from
     content, and if the label+dropdown+buttons' combined minimum width ever
     exceeds the available row width, the table (and everything after it)
     is forced wider than the window. Every element here is a plain
     inline-block with a fixed, hardcoded pixel width (see CSS) -- not a
     percentage, not a table hint, not a runtime JS measurement -- so the
     row's total width is a known constant that fits inside a small window. -->
<div class="search-card">
    <div class="sr-row" id="srRow">
        <span class="sr-lbl">SamAccountName :</span><input type="text" id="samInput" placeholder="e.g.  johndoe" /><span class="sr-lbl sr-lbl-gap">Timeout :</span><select id="timeoutSel" class="sel-input">
                    <option value="60">60s</option>
                    <option value="120">120s</option>
                    <option value="180" selected="selected">180s</option>
                    <option value="300">300s</option>
                </select><button class="btn-go" onclick="searchCulprit()">&#128270;&nbsp; Search the Culprit</button><button class="btn-clr" onclick="clearAll()">&#10006;&nbsp; Clear</button>
    </div>
</div>

<div class="tab-row">
    <button class="tab-btn tab-active" id="tabSummary" onclick="switchTab('summary')">Summary</button>
    <button class="tab-btn" id="tabDeepDive" onclick="switchTab('deepdive')">Deep Dive</button>
</div>
<div id="resultBox">  Ready -- enter a SamAccountName above and click  Search the Culprit.</div>

<div class="footer-row">
    <table><tr>
        <td id="footLeft" style="text-align:left"></td>
        <td id="footRight" style="text-align:right; white-space:nowrap;"></td>
    </tr></table>
</div>
<div class="copy-row">
    <div style="display:table-cell; vertical-align:middle; text-align:right;">
        <button class="btn-copy" id="btnCopy" onclick="copyResult()">&#128203;&nbsp;&nbsp; Copy &nbsp;&nbsp;</button>
    </div>
</div>
<div class="tool-credit">&#169; Account Lockout Investigator Tool developed by Azgar Mohammad [433390]</div>

<script language="JScript">

var PS_B64 = '';

var Global_lastReport = null;
var Global_summaryText = '';
var Global_summaryCopyText = '';
var Global_deepDiveText = '';
var Global_activeTab = 'summary';

var Global_pollTimer = null;
var Global_tickTimer = null;

// ─── Window sizing ──────────────────────────────────────────────────────────────
// Width 900px (widened from 800 per prior request). Height 790px = 760 + 30,
// per request (height only, this round). Boxes stay pinned at their explicit
// 740px width / 430px height (see CSS) -- unaffected by either change.
window.onload = function() {
    try { window.resizeTo(1080, 840); window.moveTo(60, 20); } catch(e) {}
    document.getElementById('samInput').focus();
};

// ─── Base64 decode (pure JS, no atob dependency -- works on any mshta/JScript engine) ──
function base64Decode(input) {
    var keyStr = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
    var output = '';
    var chr1, chr2, chr3, enc1, enc2, enc3, enc4;
    var i = 0;
    input = input.replace(/[^A-Za-z0-9\+\/\=]/g, '');
    while (i < input.length) {
        enc1 = keyStr.indexOf(input.charAt(i++));
        enc2 = keyStr.indexOf(input.charAt(i++));
        enc3 = keyStr.indexOf(input.charAt(i++));
        enc4 = keyStr.indexOf(input.charAt(i++));
        chr1 = (enc1 << 2) | (enc2 >> 4);
        chr2 = ((enc2 & 15) << 4) | (enc3 >> 2);
        chr3 = ((enc3 & 3) << 6) | enc4;
        output = output + String.fromCharCode(chr1);
        if (enc3 != 64) { output = output + String.fromCharCode(chr2); }
        if (enc4 != 64) { output = output + String.fromCharCode(chr3); }
    }
    return output;
}

// ─── Small formatting helpers ──────────────────────────────────────────────────
function padR(s, n) {
    s = String(s);
    if (s.length >= n) { return s.substring(0, n); }
    var pad = '';
    for (var i = 0; i < (n - s.length); i++) { pad += ' '; }
    return s + pad;
}
function rep(ch, n) {
    var s = '';
    for (var i = 0; i < n; i++) { s += ch; }
    return s;
}
// Single source of truth for report table width -- every divider line and
// column-width calculation in renderSummary/renderDeepDive/renderTimelineTable
// reads this one constant instead of repeating the literal 95 in a dozen places.
var REPORT_WIDTH = 95;
function sectionRule(L, ch) { L.push('  ' + rep(ch || '-', REPORT_WIDTH)); }
function readFileIfExists(fso, path) {
    if (!fso.FileExists(path)) { return '(no output file)'; }
    try {
        var fr = fso.OpenTextFile(path, 1, false, -1);
        var t = fr.ReadAll(); fr.Close();
        return t || '(empty)';
    } catch (e) { return '(could not read: ' + e.message + ')'; }
}

// ─── Timeline table / event-count formatting ───────────────────────────────────
var LogonTypeLabelMap = { '2': 'Interactive', '3': 'Network', '4': 'Batch', '5': 'Service', '7': 'Unlock', '8': 'NetworkCleartext', '9': 'NewCredentials', '10': 'RemoteInteractive', '11': 'CachedInteractive' };
function logonTypeLabel(t) {
    var lt = (t.RawFields && t.RawFields.LogonType) ? t.RawFields.LogonType : null;
    if (!lt) { return '-'; }
    return lt + (LogonTypeLabelMap[lt] ? (':' + LogonTypeLabelMap[lt]) : '');
}
function timelineReasonOnly(t) {
    // Reason already carries an appended "[LogonType n: X]" suffix for 4625 rows --
    // strip it since LogonType is now its own table column.
    return String(t.Reason).replace(/\s*\[LogonType[^\]]*\]/, '');
}
function renderTimelineTable(timeline) {
    // LogonType is only ever populated on 4625 rows -- for pure Kerberos/NTLM
    // (4771/4776-only) timelines it is always '-' for every row, so the column
    // is dropped entirely rather than shown blank/useless.
    var hasLogonType = false;
    var i, c;
    for (i = 0; i < timeline.length; i++) {
        if (logonTypeLabel(timeline[i]) !== '-') { hasLogonType = true; break; }
    }
    var headers = hasLogonType ? ['Time', 'EventID', 'Source', 'LogonType', 'DC'] : ['Time', 'EventID', 'Source', 'DC'];
    var rows = [];
    for (i = 0; i < timeline.length; i++) {
        var t = timeline[i];
        var time = t.TimeCreated.indexOf(' ') >= 0 ? t.TimeCreated.split(' ')[1] : t.TimeCreated;
        var row = hasLogonType ? [time, String(t.EventId), t.Src, logonTypeLabel(t), t.DC] : [time, String(t.EventId), t.Src, t.DC];
        row.push(timelineReasonOnly(t));
        rows.push(row);
    }
    var widths = [];
    for (c = 0; c < headers.length; c++) {
        var w = headers[c].length;
        for (i = 0; i < rows.length; i++) { if (rows[i][c].length > w) { w = rows[i][c].length; } }
        widths.push(w + 2);
    }
    var L = [];
    var headerLine = '  ';
    for (c = 0; c < headers.length; c++) { headerLine += padR(headers[c], widths[c]); }
    headerLine += 'Reason';
    L.push(headerLine);
    var totalW = 2;
    for (c = 0; c < headers.length; c++) { totalW += widths[c]; }
    totalW += 8;
    L.push('  ' + rep('-', Math.max(REPORT_WIDTH, totalW)));
    for (i = 0; i < rows.length; i++) {
        var line = '  ';
        for (c = 0; c < headers.length; c++) { line += padR(rows[i][c], widths[c]); }
        line += rows[i][headers.length];
        L.push(line);
    }
    return L;
}
function eventCountBreakdown(timeline) {
    var c4740 = 0, c4771 = 0, c4776 = 0, c4625 = 0, other = 0;
    for (var i = 0; i < timeline.length; i++) {
        var id = timeline[i].EventId;
        if (id == 4740) { c4740++; } else if (id == 4771) { c4771++; } else if (id == 4776) { c4776++; } else if (id == 4625) { c4625++; } else { other++; }
    }
    var parts = [];
    if (c4740) { parts.push(c4740 + 'x4740'); }
    if (c4771) { parts.push(c4771 + 'x4771'); }
    if (c4776) { parts.push(c4776 + 'x4776'); }
    if (c4625) { parts.push(c4625 + 'x4625'); }
    if (other) { parts.push(other + 'x other'); }
    return parts.length ? ('  (' + parts.join(', ') + ')') : '';
}

// ─── Summary tab ────────────────────────────────────────────────────────────────
function renderSummary(r) {
    var L = [];
    var m = r.Meta, s = r.Status;
    var header = (m.DisplayName && m.DisplayName != m.SamAccountName) ? (m.SamAccountName + ' - ' + m.DisplayName) : m.SamAccountName;

    L.push('  ' + header + '  --  LOCKOUT INVESTIGATION');
    sectionRule(L, '=');
    L.push('  ' + padR('Domain       : ' + m.Domain, 46) + 'Report Time  : ' + m.ReportTimeLocal);
    L.push('  ' + padR('DCs Searched : ' + m.DCsSearched, 46) + 'Timeout      : ' + m.TimeoutSec + 's per DC');
    sectionRule(L, '=');
    L.push('');

    if (s.IsLockedOut) {
        L.push('  STATUS:  LOCKED OUT   (confirmed via directory attribute on: ' + s.LockedOnDCs.join(', ') + ')');
    } else {
        L.push('  STATUS:  NOT LOCKED OUT   (confirmed via directory attribute on all responding DCs)');
    }
    if (!s.PDCConverged) {
        L.push('  PDC EMULATOR (' + m.PDCEmulator + '):  NOT CONVERGED -- see WARNING below. Do not trust the PDC state alone.');
    } else if (s.IsLockedOut) {
        L.push('  PDC EMULATOR (' + m.PDCEmulator + '):  converged with the lock');
    }
    sectionRule(L, '=');

    if (r.CulpritSources && r.CulpritSources.length > 0) {
        L.push('');
        L.push('  CULPRIT SOURCE IDENTIFICATION');
        sectionRule(L);
        L.push('  ' + padR('FQDN / Hostname', 45) + padR('IP Address', 20) + 'Resolved via');
        sectionRule(L);
        for (var i = 0; i < r.CulpritSources.length; i++) {
            var cs = r.CulpritSources[i];
            L.push('  ' + padR(cs.FQDN, 45) + padR(cs.IP, 20) + cs.ResolvedVia);
        }
        sectionRule(L);
        L.push('');
    }

    if (r.Timeline.length > 0) {
        var culpritSectionShown = (r.CulpritSources && r.CulpritSources.length > 0);
        if (!culpritSectionShown) { L.push(''); }
        L.push('  WHAT HAPPENED (chronological):');
        L.push('');
        var tbl = renderTimelineTable(r.Timeline);
        for (var i = 0; i < tbl.length; i++) { L.push(tbl[i]); }
    }

    if (s.WarningMessages.length > 0) {
        L.push('');
        L.push('  WARNING:');
        for (var i = 0; i < s.WarningMessages.length; i++) { L.push('    ' + s.WarningMessages[i]); }
    }

    // Everything above this point is the investigation content itself; the
    // recap block below just restates it for on-screen convenience. Copy/Paste
    // should not carry the restated recap or the UI navigation hint along with
    // it, so the copy text is captured here, before either is appended.
    var copyText = L.join('\r\n');

    L.push('');
    sectionRule(L);
    L.push('  SUMMARY');
    L.push('    ' + padR('Account', 20) + ': ' + header);
    L.push('    ' + padR('Locked On', 20) + ': ' + (s.LockedOnDCs.length ? s.LockedOnDCs.join(', ') : '(none)'));
    L.push('    ' + padR('Not Locked On', 20) + ': ' + (s.NotLockedOnDCs.length ? s.NotLockedOnDCs.join(', ') : '(none)'));
    if (s.LikelySourceMachines.length || s.LikelySourceIPs.length) {
        var srcs = s.LikelySourceMachines.concat(s.LikelySourceIPs);
        L.push('    ' + padR('Likely Source', 20) + ': ' + srcs.join(' | '));
    }
    L.push('    ' + padR('Events Found', 20) + ': ' + r.Timeline.length + eventCountBreakdown(r.Timeline));
    L.push('    ' + padR('DCs Searched', 20) + ': ' + m.DCsSearched + '  |  With Events: ' + m.DCsWithEvents.length + '  |  Errors: ' + r.Errors.length + '  |  Timed Out: ' + m.DCsTimedOut.length);
    sectionRule(L, '=');
    L.push('');
    L.push('  -> Click "Deep Dive" for full per-event attribute detail, per-DC AD state,');
    L.push('     replication metadata, and advanced diagnostics.');

    return { display: L.join('\r\n'), copy: copyText };
}

// ─── Deep Dive tab ──────────────────────────────────────────────────────────────
function renderDeepDive(r) {
    var L = [];
    var m = r.Meta;

    // Flex DC column width -- sized to the longest DC name actually returned
    // in this report (header 'DC' is the floor), shared across all three
    // Deep Dive tables below so a domain's real (possibly 15-16 char) DC
    // hostnames are never hard-truncated, regardless of naming convention.
    var dcColW = 'DC'.length;
    for (var i = 0; i < r.PerDCState.length; i++) {
        var len = String(r.PerDCState[i].DC).length;
        if (len > dcColW) { dcColW = len; }
    }
    dcColW += 2;

    L.push('  DEEP DIVE  --  ' + m.SamAccountName);
    sectionRule(L, '=');

    L.push('');
    L.push('  PER-DC AUTHORITATIVE STATE');
    sectionRule(L);
    L.push('  ' + padR('DC', dcColW) + padR('PDC?', 7) + padR('BadPwdCount', 13) + padR('LockedOut', 11) + padR('LockoutTime', 22) + 'LastBadPasswordAttempt');
    sectionRule(L);
    for (var i = 0; i < r.PerDCState.length; i++) {
        var d = r.PerDCState[i];
        if (!d.ADQuerySuccess) {
            L.push('  ' + padR(d.DC, dcColW) + padR(d.IsPDC ? 'Yes' : 'No', 7) + '[AD QUERY FAILED -- see Errors below]');
            continue;
        }
        L.push('  ' + padR(d.DC, dcColW) + padR(d.IsPDC ? 'Yes' : 'No', 7) + padR(String(d.BadPwdCount), 13) + padR(d.LockedOut ? 'Yes' : 'No', 11) + padR(d.LockoutTimeStr, 22) + d.LastBadPasswordAttempt);
    }
    sectionRule(L);

    L.push('');
    L.push('  REPLICATION METADATA (lockoutTime / badPwdCount)');
    sectionRule(L);
    if (r.ConvergenceTimeline.length === 0) {
        L.push('  (no replication metadata available -- see Errors below)');
    } else {
        L.push('  ' + padR('DC', dcColW) + padR('Attribute', 14) + padR('Version', 9) + padR('LastOriginatingChangeTime', 28) + 'OriginatingServer');
        sectionRule(L);
        for (var i = 0; i < r.ConvergenceTimeline.length; i++) {
            var c = r.ConvergenceTimeline[i];
            L.push('  ' + padR(c.DC, dcColW) + padR(c.Attribute, 14) + padR('v' + c.Version, 9) + padR(c.LastOriginatingChangeTime || '(n/a)', 28) + (c.OriginatingServer || '(unknown)'));
        }
    }
    sectionRule(L);

    L.push('');
    L.push('  FULL EVENT DETAIL (every captured EventData field)');
    sectionRule(L);
    if (r.Timeline.length === 0) {
        L.push('  (no matching events found within the lookback window)');
    }
    for (var i = 0; i < r.Timeline.length; i++) {
        var t = r.Timeline[i];
        L.push('  [' + (i + 1) + ']  Event ' + t.EventId + '  @  ' + t.TimeCreated + '  on  ' + t.DC);
        for (var k in t.RawFields) {
            L.push('        ' + padR(k, 24) + ': ' + t.RawFields[k]);
        }
        L.push('');
    }
    sectionRule(L);

    L.push('');
    L.push('  LOG RETENTION (oldest available Security-log record per DC)');
    sectionRule(L);
    for (var i = 0; i < r.PerDCState.length; i++) {
        var d = r.PerDCState[i];
        L.push('  ' + padR(d.DC, dcColW) + (d.OldestLogRecordSuccess ? (d.OldestLogRecord || '(unknown)') : ('[could not determine -- ' + d.OldestLogRecordError + ']')));
    }
    sectionRule(L);

    L.push('');
    L.push('  ERRORS / TIMEOUTS');
    sectionRule(L);
    if (r.Errors.length === 0) { L.push('  (none)'); }
    for (var i = 0; i < r.Errors.length; i++) { L.push('  [!] ' + r.Errors[i]); }
    sectionRule(L);

    L.push('');
    L.push('  ADVANCED DIAGNOSTICS');
    sectionRule(L);
    if (r.AdvancedDiagnostics) {
        var diagLines = r.AdvancedDiagnostics.split('\n');
        for (var i = 0; i < diagLines.length; i++) { L.push('  ' + diagLines[i]); }
    } else {
        L.push('  (not applicable)');
    }
    sectionRule(L);

    L.push('');
    var dcNames = [];
    for (var i = 0; i < r.PerDCState.length; i++) { dcNames.push(r.PerDCState[i].DC); }
    L.push('  DCs CHECKED (' + m.DCsSearched + '):  ' + dcNames.join('  '));

    return L.join('\r\n');
}

// ─── Tabs ───────────────────────────────────────────────────────────────────────
function switchTab(tab) {
    Global_activeTab = tab;
    if (tab == 'summary') {
        document.getElementById('resultBox').innerText = Global_summaryText || '  Ready -- enter a SamAccountName above and click  Search the Culprit.';
        document.getElementById('tabSummary').className = 'tab-btn tab-active';
        document.getElementById('tabDeepDive').className = 'tab-btn';
    } else {
        document.getElementById('resultBox').innerText = Global_deepDiveText || '  Run a search first.';
        document.getElementById('tabDeepDive').className = 'tab-btn tab-active';
        document.getElementById('tabSummary').className = 'tab-btn';
    }
}

// ─── Main search ────────────────────────────────────────────────────────────────
function searchCulprit() {
    var sam = document.getElementById('samInput').value.replace(/^\s+|\s+$/g, '');
    if (!sam) {
        document.getElementById('resultBox').innerText = '  Please enter a SamAccountName before searching.';
        return;
    }
    var lookback = 1; // fixed internally -- Security log retention is typically far shorter than any UI default we'd pick, so this is just a safe query-scope bound, not a user-facing setting
    var timeoutSec = document.getElementById('timeoutSel').value;

    Global_lastReport = null; Global_summaryText = ''; Global_summaryCopyText = ''; Global_deepDiveText = '';
    switchTab('summary');
    document.getElementById('resultBox').innerText =
        '  Discovering Domain Controllers ...\n' +
        '  Querying AD attributes, replication metadata, and Events 4740/4771/4776/4625 on each DC -- run in parallel.\n\n' +
        '  Please wait -- this may take up to a few minutes depending on the number of DCs and the selected timeout.';
    document.getElementById('footLeft').innerText = 'Discovering Domain Controllers ...';
    document.getElementById('footRight').innerText = '';

    var sh = new ActiveXObject('WScript.Shell');
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var ts = (new Date()).getTime();
    var tmp = sh.ExpandEnvironmentStrings('%TEMP%');
    var psf   = tmp + '\\ALF_' + ts + '.ps1';
    var jsonf = tmp + '\\ALF_' + ts + '.json';
    var outf  = tmp + '\\ALF_' + ts + '_stderr.txt';
    var progf = tmp + '\\ALF_' + ts + '_prog.txt';
    var donef = tmp + '\\ALF_' + ts + '_done.txt';

    try {
        var psText = base64Decode(PS_B64);
        var fw = fso.CreateTextFile(psf, true, false);
        fw.Write(psText);
        fw.Close();
    } catch (ex) {
        document.getElementById('resultBox').innerText = '  ERROR writing temp script:\n\n  ' + ex.message;
        return;
    }

    var samArg = sam.replace(/"/g, '').replace(/'/g, '').replace(/`/g, '');
    var cmd = 'cmd /c powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + psf + '"' +
        ' -Sam "' + samArg + '" -LookbackDays ' + lookback + ' -TimeoutSec ' + timeoutSec +
        ' -JsonFile "' + jsonf + '" -ProgFile "' + progf + '" -DoneFile "' + donef + '"' +
        ' > "' + outf + '" 2>&1';
    sh.Run(cmd, 0, false);

    var startTime = (new Date()).getTime();
    var timeoutSecInt = parseInt(timeoutSec, 10);
    var hardTimeoutMs = Math.max(900000, (timeoutSecInt * 1000) + 120000);

    Global_tickTimer = window.setInterval(function() {
        var elapsedSec = Math.floor(((new Date()).getTime() - startTime) / 1000);
        var marker = (elapsedSec >= timeoutSecInt) ? '  (past per-DC timeout -- finishing up slow/unreachable DCs)' : '';
        document.getElementById('footRight').innerText = 'Elapsed: ' + elapsedSec + 's  /  Per-DC timeout: ' + timeoutSecInt + 's' + marker;
    }, 1000);

    Global_pollTimer = window.setInterval(function() {
        try {
            if ((new Date()).getTime() - startTime > hardTimeoutMs) {
                window.clearInterval(Global_pollTimer);
                window.clearInterval(Global_tickTimer);
                document.getElementById('footLeft').innerText = 'Timed out. Check DC connectivity and the selected per-DC timeout.';
                return;
            }

            if (fso.FileExists(donef)) {
                window.clearInterval(Global_pollTimer);
                window.clearInterval(Global_tickTimer);
                document.getElementById('footRight').innerText = '';

                var jsonText = '';
                if (fso.FileExists(jsonf)) {
                    try {
                        var fr = fso.OpenTextFile(jsonf, 1, false, -1);
                        jsonText = fr.ReadAll(); fr.Close();
                    } catch (e1) { jsonText = ''; }
                }

                if (!jsonText) {
                    document.getElementById('resultBox').innerText = '  No JSON report was produced. Raw script output:\n\n' + readFileIfExists(fso, outf);
                    document.getElementById('footLeft').innerText = 'Failed -- see output above.';
                    return;
                }

                var report;
                try {
                    if (typeof JSON !== 'undefined' && JSON.parse) { report = JSON.parse(jsonText); }
                    else { report = eval('(' + jsonText + ')'); }
                } catch (pe) {
                    document.getElementById('resultBox').innerText = '  ERROR parsing report JSON:\n\n  ' + pe.message + '\n\n  Raw JSON (first 2000 chars):\n' + jsonText.substring(0, 2000);
                    return;
                }

                if (report.Meta && report.Meta.Error) {
                    document.getElementById('resultBox').innerText = '  ERROR: ' + report.Meta.Error;
                    document.getElementById('footLeft').innerText = 'Failed.';
                    return;
                }

                Global_lastReport = report;
                var summaryResult = renderSummary(report);
                Global_summaryText = summaryResult.display;
                Global_summaryCopyText = summaryResult.copy;
                Global_deepDiveText = renderDeepDive(report);
                switchTab('summary');
                document.getElementById('footLeft').innerText = 'Completed at ' + (new Date()).toLocaleTimeString() + '  |  Account: ' + sam;

                try { if (fso.FileExists(psf))   fso.DeleteFile(psf);   } catch (e) {}
                try { if (fso.FileExists(jsonf)) fso.DeleteFile(jsonf); } catch (e) {}
                try { if (fso.FileExists(outf))  fso.DeleteFile(outf);  } catch (e) {}
                try { if (fso.FileExists(progf)) fso.DeleteFile(progf); } catch (e) {}
                try { if (fso.FileExists(donef)) fso.DeleteFile(donef); } catch (e) {}

            } else if (fso.FileExists(progf)) {
                try {
                    var pf = fso.OpenTextFile(progf, 1, false, 0);
                    var prog = pf.ReadAll().replace(/[\r\n\s]+$/, '');
                    pf.Close();
                    if (prog) { document.getElementById('footLeft').innerText = prog; }
                } catch (e) {}
            }
        } catch (e) {}
    }, 500);
}

// ─── Copy to Clipboard (active tab) ─────────────────────────────────────────────
function copyResult() {
    var content = (Global_activeTab == 'deepdive') ? Global_deepDiveText : Global_summaryCopyText;
    if (!content) {
        document.getElementById('btnCopy').innerText = '  Nothing to copy';
        window.setTimeout(function() { document.getElementById('btnCopy').innerHTML = '&#128203;&nbsp;&nbsp; Copy &nbsp;&nbsp;'; }, 1500);
        return;
    }
    try {
        window.clipboardData.setData('Text', content);
        document.getElementById('btnCopy').innerHTML = '&#10003;&nbsp; Copied!';
        window.setTimeout(function() { document.getElementById('btnCopy').innerHTML = '&#128203;&nbsp;&nbsp; Copy &nbsp;&nbsp;'; }, 2000);
    } catch (e) {
        document.getElementById('btnCopy').innerText = '  Copy failed: ' + e.message;
    }
}

// ─── Clear ─────────────────────────────────────────────────────
function clearAll() {
    document.getElementById('samInput').value = '';
    Global_lastReport = null; Global_summaryText = ''; Global_summaryCopyText = ''; Global_deepDiveText = '';
    switchTab('summary');
    document.getElementById('resultBox').innerText = '  Ready -- enter a SamAccountName above and click  Search the Culprit.';
    document.getElementById('footLeft').innerText = '';
    document.getElementById('footRight').innerText = '';
    document.getElementById('samInput').focus();
}

document.onkeydown = function(evt) {
    var e = evt || window.event;
    if (e.keyCode === 13) {
        var t = document.activeElement || e.srcElement;
        if (t && t.id === 'samInput') { searchCulprit(); }
    }
};

</script>
</body>
</html>
